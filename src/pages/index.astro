---
import '../styles/styles.css';
import carreraData from '../data/carrera/index.json';
import catedrasData from '../data/catedras/index.json';

const nombreCarrera = carreraData.nombreCarrera || "Carrera de Psicopedagogía";
const subtitulo = carreraData.subtitulo || "Portal Académico & Red Central de Cátedras";
const cicloLectivo = carreraData.cicloLectivo || "Ciclo Lectivo 2026";
const heroTitulo = carreraData.heroTitulo || "Red de Cátedras de Psicopedagogía";
const heroDescripcion = carreraData.heroDescripcion || "Portal central que nucleariza las diferentes materias, aulas virtuales y herramientas digitales de la carrera. Accedé a cada cátedra con su repositorio en Google Drive, panel CMS y procesador de autoevaluaciones.";
const footerDescripcion = carreraData.footerDescripcion || "Portal central institucional que articula la red de cátedras y recursos digitales de la carrera.";
const footerCopy = carreraData.footerCopy || "© 2026 Portal de la Carrera de Psicopedagogía. Red Jamstack 100% gratuita.";

const tituloSeccion = catedrasData.tituloSeccion || "Cátedras Integradas";
const descripcionSeccion = catedrasData.descripcionSeccion || "Seleccioná la materia a la que deseás ingresar. Cada espacio cuenta con su propio repositorio bibliográfico en la nube, panel autogestionable y procesador pedagógico de autoevaluaciones.";
const listaCatedras = catedrasData.lista || [];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Portal oficial de la Carrera de Psicopedagogía. Red central de cátedras, recursos de estudio y herramientas pedagógicas." />
  <title>{nombreCarrera} | Red Central de Cátedras</title>
</head>
<body>

  <!-- CABECERA PRINCIPAL -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">
        <div class="brand-icon">🧠</div>
        <div class="brand-info">
          <span class="brand-title">{nombreCarrera}</span>
          <span class="brand-sub">psp.joif.net • {subtitulo}</span>
        </div>
      </a>

      <button class="mobile-toggle" aria-label="Abrir menú" aria-expanded="false">☰</button>

      <nav class="main-nav">
        <a href="/" class="nav-link active">Inicio</a>
        <a href="#catedras" class="nav-link">🏛️ Cátedras</a>
        <a href="https://evo-1.joif.net" class="nav-link" target="_blank" rel="noopener noreferrer">🌱 Evolutiva 1 ↗</a>
        <a href="https://antro.joif.net" class="nav-link" target="_blank" rel="noopener noreferrer">🏺 Antropología ↗</a>
        <a href="https://evo-1.joif.net/autoevaluacion" class="nav-link nav-link-teacher" target="_blank" rel="noopener noreferrer">📊 Analizador Excel</a>
        <a href="/keystatic" class="nav-link" style="background:#ede9fe; color:#5b21b6; border:1px solid #ddd6fe; font-weight:700;">✏️ Admin Keystatic</a>
      </nav>
    </div>
  </header>

  <!-- HERO / BIENVENIDA -->
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        <span>🏛️ Portal Madre Central</span>
        <span>•</span>
        <span>psp.joif.net</span>
        <span>•</span>
        <span>{cicloLectivo}</span>
      </div>
      <h1 class="hero-title">{heroTitulo}</h1>
      <p class="hero-lead">
        {heroDescripcion}
      </p>
      <div class="hero-actions">
        <a href="#catedras" class="btn btn-primary">
          <span>🏛️</span> Explorar Cátedras de la Carrera
        </a>
        <a href="https://evo-1.joif.net/autoevaluacion" class="btn btn-teacher" target="_blank" rel="noopener noreferrer">
          <span>📊</span> Analizador de Autoevaluaciones (Docentes) ↗
        </a>
        <a href="/keystatic" class="btn btn-outline-white">
          <span>✏️</span> Administrar en Keystatic CMS
        </a>
      </div>
    </div>
  </section>

  <!-- SECCIÓN CÁTEDRAS DE LA CARRERA (DINÁMICA DESDE KEYSTATIC) -->
  <section id="catedras" class="section" style="padding-top: 2rem;">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Red de Aulas y Materias</span>
        <h2 class="section-title">{tituloSeccion}</h2>
        <p class="section-desc">
          {descripcionSeccion}
        </p>
      </div>

      <div class="roles-grid" style="margin-top: 0; margin-bottom: 3.5rem;">
        {listaCatedras.map((catedra) => (
          <div class="role-card" style={`border-top: 5px solid ${catedra.colorBorde || '#3b82f6'};`}>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
              <div class="role-icon" style="margin-bottom: 0;">{catedra.icono || '📖'}</div>
              <span style="font-size: 0.78rem; font-weight: 700; color: #1d4ed8; background: #eff6ff; padding: 3px 10px; border-radius: 9999px; border: 1px solid #bfdbfe;">
                {catedra.subdominio || 'joif.net'}
              </span>
            </div>
            <h3 class="role-title">{catedra.nombre}</h3>
            <p class="role-desc">
              {catedra.descripcion}
            </p>
            <ul class="role-features">
              {catedra.caracteristica1 && <li>{catedra.caracteristica1}</li>}
              {catedra.caracteristica2 && <li>{catedra.caracteristica2}</li>}
              {catedra.caracteristica3 && <li>{catedra.caracteristica3}</li>}
            </ul>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 1.5rem;">
              <a href={catedra.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="flex: 1;">
                Ingresar a la Cátedra ↗
              </a>
              {catedra.urlAnalizador && (
                <a href={catedra.urlAnalizador} target="_blank" rel="noopener noreferrer" class="btn btn-teacher" title="Analizador de Excel">
                  📊 Analizador
                </a>
              )}
            </div>
          </div>
        ))}

        <!-- Próxima Cátedra -->
        <div class="role-card" style="border-top: 5px solid #94a3b8; border-style: dashed;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
            <div class="role-icon" style="margin-bottom: 0; background-color: #f1f5f9; color: #64748b;">➕</div>
            <span style="font-size: 0.78rem; font-weight: 700; color: #475569; background: #f8fafc; padding: 3px 10px; border-radius: 9999px; border: 1px solid #cbd5e1;">Próximamente</span>
          </div>
          <h3 class="role-title">Nuevas Cátedras</h3>
          <p class="role-desc">
            Espacio preparado para incorporar nuevas materias de la carrera con la misma arquitectura modular Jamstack, panel de administración y hosting 100% gratuito.
          </p>
          <ul class="role-features">
            <li>Integración inmediata bajo subdominio propio.</li>
            <li>Conexión automática a la barra institucional.</li>
            <li>Ecosistema docente unificado.</li>
          </ul>
          <div style="margin-top: 1.5rem;">
            <a href="/keystatic" class="btn" style="width: 100%; background: #e2e8f0; color: #475569; text-align:center;">
              Administrar Cátedras en Keystatic ✏️
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRESENTACIÓN DE LA CARRERA -->
  <section id="presentacion" class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Fundamentación Pedagógica</span>
        <h2 class="section-title">El Aprendizaje como Proceso Complejo y Subjetivo</h2>
        <p class="section-desc">
          Nuestra carrera concibe al aprendizaje no como una mera acumulación de conocimientos, sino como un proceso relacional, cognitivo y afectivo atravesado por la cultura y las instituciones.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.75rem; margin-top: 2rem;">
        <div style="background: white; padding: 1.75rem; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: var(--shadow-sm);">
          <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">🎯</div>
          <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--primary);">Objetivos Formativos</h3>
          <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.6;">
            Brindar herramientas epistemológicas, clínicas y pedagógicas para comprender las condiciones que posibilitan o dificultan el aprender en niños, adolescentes y adultos.
          </p>
        </div>

        <div style="background: white; padding: 1.75rem; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: var(--shadow-sm);">
          <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">🔍</div>
          <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--primary);">Perspectiva Interdisciplinaria</h3>
          <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.6;">
            Articulación entre la psicología del desarrollo, la antropología cultural, el psicoanálisis y las corrientes contemporáneas de neuroeducación e inclusión.
          </p>
        </div>

        <div style="background: white; padding: 1.75rem; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: var(--shadow-sm);">
          <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">🤝</div>
          <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--primary);">Metodología Académica</h3>
          <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.6;">
            Clases dialógicas, talleres de análisis de casos reales, trabajos prácticos grupales y actividades formativas de autoevaluación continua.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PIE DE PÁGINA -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <div class="brand">
          <div class="brand-icon">🧠</div>
          <div class="brand-info">
            <span class="brand-title">{nombreCarrera}</span>
            <span class="brand-sub">psp.joif.net</span>
          </div>
        </div>
        <p class="footer-text">
          {footerDescripcion}
        </p>
      </div>

      <div class="footer-links-group">
        <h4 class="footer-heading">Cátedras Integradas</h4>
        <ul class="footer-links">
          {listaCatedras.map(c => (
            <li><a href={c.url} target="_blank" rel="noopener noreferrer">{c.icono || '📖'} {c.nombre}</a></li>
          ))}
          <li><a href="https://evo-1.joif.net/autoevaluacion" target="_blank" rel="noopener noreferrer">📊 Analizador de Autoevaluaciones</a></li>
          <li><a href="/keystatic">✏️ Admin Keystatic</a></li>
        </ul>
      </div>
    </div>

    <div class="container footer-bottom">
      <p>{footerCopy}</p>
    </div>
  </footer>

</body>
</html>
