---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import { getMateriasTree, getAllMaterias } from '../utils/materias';
import carreraData from '../data/carrera/index.json';

const tree = getMateriasTree();
const allMaterias = getAllMaterias();
---

<ObsidianLayout
  title="Portal Académico y Red de Cátedras"
  description={carreraData.heroDescripcion}
>
  <div class="home-container">
    <!-- Hero Banner -->
    <header class="home-hero">
      <div class="hero-badge">
        <span>🏛️ Portal Central</span>
        <span>•</span>
        <span>psp.joif.net</span>
        <span>•</span>
        <span>Plan Res. 18/13</span>
      </div>

      <h1 class="hero-title">Red de Cátedras de Psicopedagogía</h1>
      <p class="hero-desc">
        {carreraData.heroDescripcion}
      </p>

      <!-- Prominent Search Bar -->
      <div class="hero-search-box" id="hero-search-trigger">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="hero-search-text">Buscar entre las 32 materias, apuntes, temas o correlatividades...</span>
        <kbd class="hero-search-kbd">Ctrl + K</kbd>
      </div>

      <!-- Quick Action Buttons -->
      <div class="hero-actions">
        <a href="#plan" class="hero-btn primary-btn">
          <span>📂</span> Explorar 32 Materias
        </a>
        <a href="/correlatividades" class="hero-btn outline-btn">
          <span>🔗</span> Mapa de Correlatividades
        </a>
        <a href="/analizador" class="hero-btn analyzer-btn">
          <span>📊</span> Analizador Excel (Docentes)
        </a>
        <a href="/keystatic" class="hero-btn cms-btn">
          <span>✏️</span> Administrar en Keystatic
        </a>
      </div>
    </header>

    <!-- Plan por Años (Grid de Años) -->
    <section id="plan" class="plan-section">
      <div class="section-header">
        <span class="section-tag">Plan de Estudios Oficial</span>
        <h2 class="section-title">Estructura Curricular por Años</h2>
        <p class="section-sub">
          Navegá por las 32 cátedras de la carrera. Cada materia cuenta con su ficha detallada, requisitos de correlatividad para cursar y rendir, y carpeta de Google Drive.
        </p>
      </div>

      <div class="years-grid">
        {tree.map(ano => (
          <div class="year-card">
            <div class="year-header">
              <div class="year-title-box">
                <span class="year-number">0{ano.ano}</span>
                <h3 class="year-title">{ano.label}</h3>
              </div>
              <span class="year-total-badge">
                {ano.cuatrimestres.reduce((acc, c) => acc + c.materias.length, 0)} Materias
              </span>
            </div>

            <div class="cuatris-wrapper">
              {ano.cuatrimestres.map(c => (
                <div class="cuatri-group">
                  <h4 class="cuatri-heading">{c.label}</h4>
                  <ul class="materia-mini-list">
                    {c.materias.map(m => (
                      <li>
                        <a href={`/m/${m.slug}`} class="materia-mini-link">
                          <span class="mini-num">{m.numero}</span>
                          <span class="mini-icon">{m.icono || '📄'}</span>
                          <span class="mini-name">{m.nombre}</span>
                          {m.paraCursar.length > 0 && (
                            <span class="mini-req-dot" title="Tiene correlatividades previas">🔗</span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Features / Tools Section -->
    <section class="tools-section">
      <div class="tool-card">
        <div class="tool-icon">📁</div>
        <h3 class="tool-title">Archivos y Google Drive</h3>
        <p class="tool-desc">
          Acceso libre y organizado a las carpetas en la nube de cada una de las materias, con programas, bibliografía y guías de estudio.
        </p>
      </div>

      <div class="tool-card">
        <div class="tool-icon">📊</div>
        <h3 class="tool-title">Analizador de Autoevaluaciones</h3>
        <p class="tool-desc">
          Herramienta pedagógica integrada para procesar al instante las respuestas de Google Forms en formato Excel (.xlsx).
        </p>
        <a href="/analizador" class="tool-link">Abrir Analizador ↗</a>
      </div>

      <div class="tool-card">
        <div class="tool-icon">✏️</div>
        <h3 class="tool-title">Autogestión con Keystatic CMS</h3>
        <p class="tool-desc">
          Panel 100% autogestionable con sincronización directa a GitHub para actualizar links, bibliografía y docentes de forma gratuita.
        </p>
        <a href="/keystatic" class="tool-link">Ir al Panel CMS ↗</a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="home-footer">
      <p>{carreraData.footerDescripcion}</p>
      <p class="footer-copy">{carreraData.footerCopy}</p>
    </footer>
  </div>

  <script>
    const heroSearch = document.getElementById('hero-search-trigger');
    if (heroSearch && window.openQuickSearch) {
      heroSearch.addEventListener('click', () => window.openQuickSearch());
    }
  </script>
</ObsidianLayout>

<style>
  .home-container {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Hero Banner */
  .home-hero {
    padding: 2.5rem 0 1.5rem 0;
    border-bottom: 1px solid var(--border-vault);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-top: 1rem;
    line-height: 1.6;
    max-width: 780px;
  }

  /* Hero Search Bar */
  .hero-search-box {
    margin-top: 2rem;
    background: var(--bg-card);
    border: 1.5px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    max-width: 680px;
  }

  .hero-search-box:hover {
    border-color: var(--accent-purple);
    background: var(--bg-card-hover);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  .hero-search-box svg {
    color: var(--accent-purple);
    flex-shrink: 0;
  }

  .hero-search-text {
    flex: 1;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .hero-search-kbd {
    background: var(--bg-vault);
    border: 1px solid var(--border-vault);
    font-size: 0.75rem;
  }

  /* Hero Actions */
  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.15s;
  }

  .primary-btn {
    background: var(--accent-purple);
    color: white;
  }

  .primary-btn:hover {
    background: var(--accent-purple-hover);
    color: #161618;
  }

  .outline-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    color: var(--text-main);
  }

  .outline-btn:hover {
    border-color: var(--accent-purple);
  }

  .analyzer-btn {
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .analyzer-btn:hover {
    background: rgba(59, 130, 246, 0.25);
  }

  .cms-btn {
    background: rgba(139, 92, 246, 0.12);
    color: #c4b5fd;
    border: 1px solid rgba(139, 92, 246, 0.25);
  }

  .cms-btn:hover {
    background: rgba(139, 92, 246, 0.25);
  }

  /* Years Grid */
  .plan-section {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .section-tag {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: var(--accent-purple);
    text-transform: uppercase;
  }

  .section-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 4px 0 6px 0;
  }

  .section-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 740px;
    line-height: 1.5;
  }

  .years-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .year-card {
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .year-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-vault);
  }

  .year-title-box {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .year-number {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-purple);
    background: var(--bg-vault);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .year-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .year-total-badge {
    font-size: 0.72rem;
    color: var(--text-faint);
    background: var(--bg-vault);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .cuatris-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cuatri-heading {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .materia-mini-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .materia-mini-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    background: var(--bg-vault);
    border: 1px solid transparent;
    font-size: 0.84rem;
    color: var(--text-muted);
    transition: all 0.12s;
  }

  .materia-mini-link:hover {
    color: var(--text-main);
    background: var(--bg-card-hover);
    border-color: var(--accent-purple);
    transform: translateX(3px);
  }

  .mini-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .mini-icon {
    font-size: 0.85rem;
  }

  .mini-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini-req-dot {
    font-size: 0.72rem;
    opacity: 0.7;
  }

  /* Tools Section */
  .tools-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .tool-card {
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tool-icon {
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  .tool-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .tool-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
  }

  .tool-link {
    font-size: 0.82rem;
    color: var(--accent-purple-hover);
    font-weight: 600;
    margin-top: 0.5rem;
  }

  .tool-link:hover {
    text-decoration: underline;
  }

  /* Footer */
  .home-footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border-vault);
    font-size: 0.85rem;
    color: var(--text-faint);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }

  .footer-copy {
    font-size: 0.78rem;
  }
</style>
