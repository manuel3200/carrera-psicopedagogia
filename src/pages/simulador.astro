  }

  .kpi-cursar .kpi-val { color: #38bdf8; text-shadow: 0 0 10px rgba(56, 189, 248, 0.3); }
  .kpi-rendir .kpi-val { color: #c084fc; text-shadow: 0 0 10px rgba(192, 132, 252, 0.3); }
