    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
  }

  .preset-danger {
    background: rgba(239, 68, 68, 0.18);
    border: 1.5px solid #ef4444;
    color: #fca5a5;
  }

  .preset-danger:hover {
    background: #ef4444;
    border-color: #ef4444;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
