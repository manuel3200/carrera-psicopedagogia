  /* Toolbar de Filtros & Búsqueda */
  .sim-filter-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .filter-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.86rem;
    font-weight: 600;
    background: #22222c;
    color: #d4d4d8;
    border: 1.5px solid #363646;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-tab:hover {
    background: #2b2b38;
    color: #ffffff;
    border-color: #585870;
  }

  .filter-tab.active {
    background: #7c3aed;
    color: #ffffff;
    border-color: #8b5cf6;
    font-weight: 700;
    box-shadow: 0 3px 12px rgba(124, 58, 237, 0.45);
  }

  .tab-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: var(--font-mono, monospace);
  }

  .sim-search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #1c1c24;
    border: 1.5px solid #3a3a4c;
    border-radius: 8px;
    padding: 0.55rem 1rem;
    min-width: 270px;
    color: #a1a1aa;
    transition: all 0.15s ease;
  }

  .sim-search-box input {
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 0.88rem;
    width: 100%;
  }

  .sim-search-box input::placeholder {
    color: #828290;
  }

  .sim-search-box:focus-within {
    border-color: #8b5cf6;
    background: #22222d;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.25);
  }

  /* Bloque de Año */
  .year-block {
    margin-bottom: 2.5rem;
  }

  .year-block-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1.5px solid #2f2f3c;
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .year-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .year-tag {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    background: #7c3aed;
    color: #ffffff;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    letter-spacing: 0.05em;
  }

  .year-heading {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .year-stats-badge {
    font-size: 0.85rem;
    font-weight: 600;
    color: #a1a1aa;
    font-family: var(--font-mono, monospace);
  }

  /* Grilla de Tarjetas */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.25rem;
  }

  /* Tarjeta de Materia (CONTRASTE MEJORADO) */
  .sim-materia-card {
    background: #1b1b22;
    border: 1.5px solid #2e2e3a;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .sim-materia-card:hover {
    border-color: #6d28d9;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  /* Bordes y fondos según estado de la materia */
  .sim-materia-card[data-status="A"] {
    border-color: #059669;
    background: linear-gradient(180deg, rgba(16, 185, 129, 0.12) 0%, #1b1b22 100%);
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.12);
  }

  .sim-materia-card[data-status="R"] {
    border-color: #d97706;
    background: linear-gradient(180deg, rgba(245, 158, 11, 0.12) 0%, #1b1b22 100%);
    box-shadow: 0 4px 16px rgba(245, 158, 11, 0.12);
  }

  /* Head de tarjeta */
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .card-num-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex: 1;
  }

  .card-num {
    font-size: 0.78rem;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    color: #c4b5fd;
    background: rgba(124, 58, 237, 0.25);
    border: 1px solid rgba(124, 58, 237, 0.4);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
  }

  .card-icon {
    font-size: 1.2rem;
  }

  .card-title-link {
    font-size: 1.02rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    line-height: 1.3;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s;
  }

  .card-title-link:hover {
    color: #a78bfa;
  }

  .link-ext-icon {
    font-size: 0.75rem;
    color: #71717a;
  }

  .card-cuatri-pill {
    font-size: 0.74rem;
    font-weight: 600;
    color: #d4d4d8;
    background: #242430;
    border: 1px solid #383848;
    padding: 0.22rem 0.6rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  /* Selector Segmentado de Estado (REDISEÑO DE ALTO CONTRASTE) */
  .status-selector-row {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    background: #14141a;
    border: 1px solid #2d2d38;
    border-radius: 10px;
    padding: 0.7rem;
  }

  .selector-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: #a1a1aa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .segmented-control {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: #0d0d12;
    border: 1.5px solid #2d2d38;
    border-radius: 8px;
    padding: 3px;
    gap: 4px;
  }

  .segment-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.55rem 0.35rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .segment-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Botón 1: Pendiente */
  .segment-btn[data-set-status="P"] {
    background: #1c1c24;
    color: #9ca3af;
    border-color: #2b2b36;
  }
  .segment-btn[data-set-status="P"]:hover {
    background: #252530;
    color: #ffffff;
    border-color: #4b5563;
  }
  .segment-btn.active[data-set-status="P"] {
    background: #2d303a;
    color: #ffffff;
    border: 1.5px solid #6b7280;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }
  .bullet-p {
    background: #9ca3af;
  }
  .segment-btn.active[data-set-status="P"] .bullet-p {
    background: #ffffff;
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.8);
  }

  /* Botón 2: Regular (R) */
  .segment-btn[data-set-status="R"] {
    background: #241d14;
    color: #f59e0b;
    border-color: #453013;
  }
  .segment-btn[data-set-status="R"]:hover {
    background: #332615;
    color: #fbbf24;
    border-color: #78350f;
  }
  .segment-btn.active[data-set-status="R"] {
    background: #78350f;
    color: #fffbeb;
    border: 1.5px solid #f59e0b;
    font-weight: 700;
    box-shadow: 0 2px 10px rgba(245, 158, 11, 0.45);
  }
  .bullet-r {
    background: #f59e0b;
  }
  .segment-btn.active[data-set-status="R"] .bullet-r {
    background: #fbbf24;
    box-shadow: 0 0 8px #f59e0b;
  }

  /* Botón 3: Aprobada (A) */
  .segment-btn[data-set-status="A"] {
    background: #112217;
    color: #10b981;
    border-color: #134e2e;
  }
  .segment-btn[data-set-status="A"]:hover {
    background: #143521;
    color: #34d399;
    border-color: #065f46;
  }
  .segment-btn.active[data-set-status="A"] {
    background: #065f46;
    color: #ecfdf5;
    border: 1.5px solid #10b981;
    font-weight: 700;
    box-shadow: 0 2px 10px rgba(16, 185, 129, 0.45);
  }
  .bullet-a {
    background: #10b981;
  }
  .segment-btn.active[data-set-status="A"] .bullet-a {
    background: #34d399;
    box-shadow: 0 0 8px #10b981;
  }

  /* Banners Evaluativos Dinámicos */
  .eval-banner-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .eval-badge {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border-radius: 8px;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .eval-icon {
    font-size: 1.25rem;
    line-height: 1.1;
    flex-shrink: 0;
  }

  .eval-text strong {
    display: block;
    font-size: 0.86rem;
    margin-bottom: 0.15rem;
  }

  .eval-text span {
    font-size: 0.78rem;
    opacity: 0.95;
  }

  .eval-approved {
    background: #022c22;
    border: 1.5px solid #059669;
    color: #ecfdf5;
  }
  .eval-approved strong { color: #34d399; }

  .eval-can-cursar {
    background: #082f49;
    border: 1.5px solid #0284c7;
    color: #f0f9ff;
  }
  .eval-can-cursar strong { color: #38bdf8; }

  .eval-can-rendir {
    background: #3b0764;
    border: 1.5px solid #9333ea;
    color: #faf5ff;
  }
  .eval-can-rendir strong { color: #c084fc; }

  .eval-locked {
    background: #2d1215;
    border: 1.5px solid #b91c1c;
    color: #fef2f2;
  }
  .eval-locked strong { color: #f87171; }

  .eval-locked-rendir {
    background: #2d1d06;
    border: 1.5px solid #b45309;
    color: #fffbeb;
  }
  .eval-locked-rendir strong { color: #fbbf24; }

  /* Desglose de Correlatividades */
  .correlat-details {
    background: #141419;
    border: 1px solid #2d2d3a;
    border-radius: 8px;
    overflow: hidden;
  }

  .details-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #d4d4d8;
    background: #181820;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background 0.15s;
  }

  .details-summary:hover {
    background: #20202a;
    color: #ffffff;
  }

  .details-summary::-webkit-details-marker {
    display: none;
  }

  .details-toggle-icon {
    font-size: 0.8rem;
    color: #a1a1aa;
    transition: transform 0.2s;
  }

  .correlat-details[open] .details-toggle-icon {
    transform: rotate(180deg);
  }

  .details-body {
    padding: 0.75rem;
    border-top: 1px solid #272734;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .req-section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .req-type-title {
    font-size: 0.72rem;
    font-weight: 800;
    color: #a1a1aa;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .req-free {
    font-size: 0.78rem;
    color: #34d399;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(16, 185, 129, 0.08);
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .req-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .req-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    background: #1a1a22;
    border: 1px solid #2b2b36;
  }

  .req-satisfied {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.35);
  }

  .req-pending {
    background: rgba(239, 68, 68, 0.08);
    border-color: rgba(239, 68, 68, 0.35);
  }

  .req-icon {
    font-size: 0.82rem;
    font-weight: 800;
    width: 16px;
    text-align: center;
  }

  .req-satisfied .req-icon { color: #34d399; }
  .req-pending .req-icon { color: #f87171; }

  .req-text {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    color: #f4f4f5;
  }

  .req-inline-link {
    color: #f4f4f5;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #4b5563;
  }

  .req-inline-link:hover {
    color: #a78bfa;
    text-decoration-color: #a78bfa;
  }

  .req-condition-tag {
    font-size: 0.7rem;
    color: #e4e4e7;
    background: #252532;
    border: 1px solid #3a3a4c;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .req-current-state {
    font-size: 0.72rem;
    font-weight: 700;
    font-family: var(--font-mono, monospace);
  }

  .state-a { color: #34d399; }
  .state-r { color: #fbbf24; }
  .state-p { color: #9ca3af; }

  /* Estado Vacío */
  .sim-empty-state {
    text-align: center;
    padding: 4rem 1.5rem;
    background: #191920;
    border: 1.5px dashed #3a3a4c;
    border-radius: 12px;
    margin: 2rem 0;
  }

  .empty-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .empty-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.5rem;
  }

  .empty-desc {
    font-size: 0.95rem;
    color: #a1a1aa;
    margin: 0 0 1.5rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .dashboard-main-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .quick-kpis {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .sim-title {
      font-size: 1.6rem;
    }
    .cards-grid {
      grid-template-columns: 1fr;
    }
    .sim-filter-toolbar {
      flex-direction: column;
      align-items: stretch;
    }
    .sim-search-box {
      min-width: unset;
      width: 100%;
    }
    .actions-group {
      width: 100%;
    }
    .preset-print {
      margin-left: 0;
    }
    .segmented-control {
      grid-template-columns: 1fr;
    }
  }

  /* Ocultar Ficha de Impresión en pantalla */
  .print-sheet {
    display: none;
  }

  /* Modo Impresión Oficial (Ficha Académica A4 Ultra-Compacta en 1-2 páginas) */
  @media print {
    @page {
      size: A4 portrait;
      margin: 8mm 7mm 8mm 7mm;
    }

    *, *::before, *::after {
      box-sizing: border-box !important;
      text-shadow: none !important;
    }

    :global(html),
    :global(body) {
      background: #ffffff !important;
      color: #0f172a !important;
      font-size: 8pt !important;
      line-height: 1.25 !important;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    /* Ocultar toda la interfaz web interactiva */
    :global(.vault-topbar),
    :global(#obsidian-sidebar),
    :global(.sidebar-ribbon),
    :global(#sidebar-backdrop),
    :global(.quick-search-modal),
    :global(.vault-footer),
    .sim-header,
    .sim-dashboard,
    .sim-actions-toolbar,
    .sim-filter-toolbar,
    .sim-years-container,
    .sim-empty-state {
      display: none !important;
    }

    :global(.vault-layout),
    :global(.vault-main),
    .simulador-page {
      display: block !important;
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      border: none !important;
      background: #ffffff !important;
    }

    /* Mostrar Hoja de Impresión Oficial */
    .print-sheet {
      display: block !important;
      width: 100% !important;
      color: #0f172a !important;
    }

    /* Cabecera Oficial */
    .print-header {
      border-bottom: 2px solid #0f172a;
      padding-bottom: 5px;
      margin-bottom: 7px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .print-header-main h1 {
      font-size: 13pt;
      font-weight: 800;
      margin: 0 0 2px 0;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #0f172a;
    }

    .print-header-main p {
      font-size: 8pt;
      margin: 0;
      color: #475569;
      font-weight: 600;
    }

    .print-header-meta {
      text-align: right;
      font-size: 7.2pt;
      color: #64748b;
      line-height: 1.3;
    }

    .print-header-meta strong {
      color: #0f172a;
    }

    /* Resumen Ejecutivo (KPI Box) */
    .print-summary-box {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 6px;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      padding: 5px 8px;
      margin-bottom: 7px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .print-metric {
      text-align: center;
      border-right: 1px solid #e2e8f0;
      padding: 0 4px;
    }

    .print-metric:last-child {
      border-right: none;
    }

    .print-metric-num {
      display: block;
      font-size: 11pt;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.1;
    }

    .print-metric-lbl {
      display: block;
      font-size: 6.8pt;
      font-weight: 700;
      text-transform: uppercase;
      color: #64748b;
      margin-top: 1px;
    }

    /* Próximas Habilitaciones Académicas (2 columnas) */
    .print-next-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px;
      margin-bottom: 7px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .print-next-col {
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      padding: 5px 7px;
      background: #ffffff;
    }

    .print-next-title {
      font-size: 7.4pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      color: #1e293b;
      margin: 0 0 4px 0;
      padding-bottom: 3px;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .print-chips-container {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .print-item-chip {
      font-size: 7pt;
      line-height: 1.25;
      color: #1e293b;
    }

    .print-pill-sub {
      color: #64748b;
      font-size: 6.5pt;
    }

    .print-empty-note {
      font-size: 7pt;
      color: #94a3b8;
      font-style: italic;
    }

    /* Tabla Oficial de las 32 Asignaturas */
    .print-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 7.2pt;
      line-height: 1.15;
      margin-bottom: 5px;
    }

    .print-table thead {
      display: table-header-group;
    }

    .print-table th {
      background: #1e293b !important;
      color: #ffffff !important;
      font-weight: 700;
      text-transform: uppercase;
      font-size: 6.7pt;
      letter-spacing: 0.3px;
      padding: 3.5px 5px;
      text-align: left;
      border: 1px solid #0f172a;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .print-table td {
      padding: 2.2px 5px;
      border: 1px solid #cbd5e1;
      vertical-align: middle;
    }

    .print-table tr:nth-child(even) td {
      background: #f8fafc;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .print-table tr {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .col-num {
      width: 4%;
      font-weight: 700;
      text-align: center;
      color: #475569;
    }

    .col-ano {
      width: 9%;
      font-weight: 600;
      color: #334155;
      text-align: center;
      white-space: nowrap;
    }

    .col-nombre {
      width: 37%;
      font-weight: 600;
      color: #0f172a;
    }

    .col-estado {
      width: 13%;
      text-align: center;
      white-space: nowrap;
    }

    .col-cond {
      width: 18.5%;
      font-size: 6.8pt;
      color: #334155;
    }

    .col-final {
      width: 18.5%;
      font-size: 6.8pt;
      color: #334155;
    }

    /* Badges de Estado en Impresión */
    .print-status-badge {
      display: inline-block;
      padding: 1px 4px;
      border-radius: 2px;
      font-size: 6.2pt;
      font-weight: 800;
      letter-spacing: 0.2px;
      text-align: center;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .print-status-a {
      background: #dcfce7 !important;
      color: #14532d !important;
      border: 1px solid #86efac;
    }

    .print-status-r {
