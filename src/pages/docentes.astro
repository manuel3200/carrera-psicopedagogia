  }

  /* Template Card */
  .template-card {
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
  }

  .template-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .template-header h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .template-sub {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .copy-template-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--bg-card-hover);
    border: 1px solid var(--border-subtle);
