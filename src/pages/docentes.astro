---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import docentesDataRaw from '../data/docentes/index.json';

const data = docentesDataRaw || {
  badge: "ESPACIO PARA EQUIPOS DE CÁTEDRA • SOPORTE Y HERRAMIENTAS",
  titulo: "Espacio Docente y Centro de Contacto",
  descripcion: "Este portal es un proyecto autogestionado por Manuel Ortiz, estudiante de la carrera de Psicopedagogía. Su finalidad es colaborar activamente con los profesores, adscriptos y auxiliares, centralizando el material bibliográfico, facilitando herramientas pedagógicas digitales y brindando un canal ágil para mantener las 32 cátedras actualizadas.",
  whatsappNumero: "+54 370 502-1874",
  whatsappLink: "https://wa.me/543705021874?text=Hola%20Manuel%2C%20te%20escribo%20desde%20el%20portal%20psp.joif.net%20para%20acercarte%20datos%20de%20la%20c%C3%A1tedra%3A",
  emailContacto: "manuelortiz1188@gmail.com",
  youtubeUrl: "",
  youtubeTitulo: "Video Tutorial: Cómo configurar Google Forms y procesar el Excel",
  youtubeDescripcion: "Mirá en este video paso a paso cómo convertir tu formulario en cuestionario, asignar respuestas correctas y procesar las notas al instante en el analizador."
};

function getYouTubeId(url: string) {
  if (!url) return null;
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  return match ? match[1] : null;
}

const youtubeId = getYouTubeId(data.youtubeUrl);
---

<ObsidianLayout
  title="Espacio Docente, Soporte y Contacto"
  description="Guía detallada de configuración de Google Forms, uso del analizador de autoevaluaciones Excel y canales directos de contacto con Manuel Ortiz."
  breadcrumbs={[{ label: 'Espacio Docente' }]}
>
  <div class="docentes-page">
    <!-- Header -->
    <header class="docentes-header">
      <div class="docentes-badge">
        <span>👨‍🏫 {data.badge}</span>
      </div>
      <h1 class="docentes-title">{data.titulo}</h1>
      <p class="docentes-lead">
        {data.descripcion}
      </p>
      <div class="cms-shortcut-pill">
        <span>✏️ Todo este apartado es editable en Keystatic CMS:</span>
        <a href="/keystatic/singleton/docentes" class="cms-pill-link">Editar esta página en el CMS ↗</a>
      </div>
    </header>

    <!-- Communication Cards (WhatsApp & Correo) -->
    <section class="docentes-section">
      <div class="section-tag-box">
        <span class="tag-title">COMUNICACIÓN DIRECTA</span>
        <h2>Canales de Contacto con Manuel Ortiz</h2>
        <p class="section-desc">Elegí el medio que te resulte más cómodo para enviar programas, enlaces de Google Drive, correcciones o consultas sobre el portal.</p>
      </div>

      <div class="contact-grid">
        <!-- WhatsApp Card -->
        <div class="contact-card whatsapp-card">
          <div class="contact-icon-box whatsapp-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.101.005.234-.038.364.275.144.346.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.963 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.436 5.176L2 22l4.981-1.396A9.958 9.958 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.05c-1.634 0-3.148-.521-4.385-1.408l-.314-.225-2.955.828.84-2.859-.247-.336A8.04 8.04 0 0 1 3.95 12c0-4.439 3.611-8.05 8.05-8.05 4.439 0 8.05 3.611 8.05 8.05 0 4.439-3.611 8.05-8.05 8.05z"/>
            </svg>
          </div>
          <div class="contact-details">
            <span class="contact-type">WHATSAPP DIRECTO</span>
            <h3 class="contact-name">{data.whatsappNumero}</h3>
            <p class="contact-desc">Ideal para enviar enlaces rápidos, fotos de programas, audios o coordinar la carga de material.</p>
          </div>
          <a
            href={data.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-action-btn whatsapp-btn"
          >
            <span>💬 Abrir WhatsApp</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>

        <!-- Email Card -->
        <div class="contact-card email-card">
          <div class="contact-icon-box email-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div class="contact-details">
            <span class="contact-type">CORREO ELECTRÓNICO</span>
            <h3 class="contact-name">{data.emailContacto}</h3>
            <p class="contact-desc">Para adjuntar programas analíticos extensos en PDF, resoluciones o planificaciones anuales.</p>
          </div>
          <a
            href={`mailto:${data.emailContacto}?subject=Portal%20Psicopedagogia%20-%20Datos%20de%20Catedra&body=Hola%20Manuel%2C%0A%0AC%C3%A1tedra%3A%20%0AApartado%20a%20editar%3A%20%0ADatos%20a%20modificar%3A%20%0A`}
            class="contact-action-btn email-btn"
          >
            <span>✉️ Enviar Correo</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Mini Guía de Edición / Plantilla -->
    <section class="docentes-section">
      <div class="template-card">
        <div class="template-header">
          <div class="template-title-box">
            <span class="tag-title">MINI GUÍA DE SOLICITUD</span>
            <h2>¿Cómo enviarme los datos para actualizar la página de tu materia?</h2>
          </div>
          <button id="copy-template-btn" class="copy-template-btn" title="Copiar plantilla al portapapeles">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span id="copy-btn-text">Copiar Plantilla</span>
          </button>
        </div>
        <p class="template-sub">
          Para que la carga sea inmediata y exacta, podés copiar y pegar esta estructura en WhatsApp o Correo completando los datos:
        </p>
        <div class="template-code-box">
          <pre id="template-text"><code>📚 Cátedra / Materia: [Ej: 05. Psicología Evolutiva I]
📌 Apartado a editar: [Ej: Enlace de Google Drive / Docentes / Programa / Bibliografía]
✏️ Datos nuevos o a modificar:
- Enlace / Archivo: [Pegá aquí el link de Drive o adjuntá el documento]
- Docentes a cargo: [Nombre, Apellido y Cargo o contacto]
- Modificación requerida: [Explicá qué texto o unidad querés cambiar]
📝 Observaciones adicionales: [Cualquier aclaración que consideres relevante]</code></pre>
        </div>
      </div>
    </section>

    <!-- GUÍA COMPLETA Y DETALLADA DEL ANALIZADOR DE AUTOEVALUACIONES -->
    <section class="docentes-section" id="guia-analizador">
      <div class="guide-main-card">
        <div class="guide-header-top">
          <div class="guide-icon-badge">📊</div>
          <div>
            <span class="tag-title">HERRAMIENTA PEDAGÓGICA INTEGRADA</span>
            <h2 class="guide-main-title">Guía Completa: Configuración de Google Forms y Uso del Analizador Excel</h2>
            <p class="guide-main-desc">
              Aprendé a configurar correctamente tus formularios de Google Forms para que el sistema procese automáticamente las respuestas, calcule promedios, grafique el rendimiento y detecte dudas conceptuales sin tocar fórmulas.
            </p>
          </div>
        </div>

        <!-- PASO 1: CONFIGURACIÓN DEL FORMULARIO -->
        <div class="guide-step-block">
          <div class="step-num-badge">1</div>
          <div class="step-body">
            <div class="step-header-text">
              <h3>Configuración del Cuestionario en Google Forms</h3>
              <span class="step-sub">Requisitos indispensables en el formulario</span>
            </div>
            <p>Al crear o editar el formulario de autoevaluación o trabajo práctico para los estudiantes:</p>
            
            <ul class="step-bullet-list">
              <li>
                <strong>Pestaña "Configuración":</strong> Activá el interruptor principal <strong>"Convertir en cuestionario"</strong>. Esto habilita la asignación de puntos y respuestas correctas.
              </li>
              <li>
                <strong>Puntuación de las preguntas:</strong> Asignale un valor en puntos a cada pregunta (por ejemplo, 1 punto cada una, o el puntaje total que prefiera la cátedra).
              </li>
              <li>
                <strong>Clave de respuestas:</strong> En cada pregunta de opción múltiple, hacé clic abajo a la izquierda en <strong>"Clave de respuestas"</strong> y seleccioná la opción correcta.
              </li>
              <li>
                <strong>Pestaña "Preguntas" (Identificación del estudiante):</strong>
                <ul class="sub-bullet-list">
                  <li>Asegurate de activar la recopilación de <strong>Dirección de correo electrónico</strong>.</li>
                  <li>Creá un campo obligatorio de tipo <em>Respuesta corta</em> con el título exacto: <strong>"Apellido y Nombre"</strong>. Esto permitirá al analizador ordenar nominalmente a los estudiantes.</li>
                </ul>
              </li>
              <li>
                <strong>Pregunta opcional de dudas conceptuales:</strong> Podés añadir una última pregunta abierta de tipo párrafo: <em>"Consultas o dudas conceptuales para la clase presencial"</em>. El analizador la reconocerá automáticamente y agrupará todas las consultas en un buzón pedagógico.
              </li>
            </ul>

            <div class="callout callout-tip">
              💡 <strong>Tip para las autoevaluaciones:</strong> No es necesario que las preguntas estén numeradas con números romanos; redactalas con claridad y con opciones directas (Varias opciones o Casillas).
            </div>
          </div>
        </div>

        <!-- PASO 2: DESCARGAR EXCEL -->
        <div class="guide-step-block">
          <div class="step-num-badge">2</div>
          <div class="step-body">
            <div class="step-header-text">
              <h3>Descargar el Archivo Excel (.xlsx)</h3>
              <span class="step-sub">Exportación directa desde Google Forms</span>
            </div>
            <p>Una vez que los estudiantes hayan finalizado el plazo para responder:</p>
            
            <ol class="step-ordered-list">
              <li>Ingresá a tu formulario en <strong>Google Forms</strong> y hacé clic en la pestaña <strong>"Respuestas"</strong> (en la parte superior).</li>
              <li>Hacé clic en el ícono verde de <strong>"Vincular con Hojas de cálculo"</strong> (o <em>"Ver en Hojas de cálculo"</em>). Se abrirá Google Sheets en una nueva pestaña.</li>
              <li>En el menú superior de Google Sheets, hacé clic en <strong>Archivo ➔ Descargar ➔ Microsoft Excel (.xlsx)</strong>.</li>
              <li>El archivo se descargará directamente en tu carpeta de Descargas o escritorio.</li>
            </ol>

            <div class="callout callout-info">
              📄 <strong>Formato aceptado:</strong> La herramienta admite archivos <code>.xlsx</code> o <code>.xls</code> generados directamente por Google Sheets / Excel.
            </div>
          </div>
        </div>

        <!-- PASO 3: ESTRUCTURA DE COLUMNAS -->
        <div class="guide-step-block">
          <div class="step-num-badge">3</div>
          <div class="step-body">
            <div class="step-header-text">
              <h3>Estructura de Columnas Requerida</h3>
              <span class="step-sub">Orden y encabezados de la fila 1</span>
            </div>
            <p>Google Forms genera de manera automática el orden adecuado. Asegurate de que la fila 1 de encabezados se mantenga intacta:</p>

            <div class="excel-preview-wrapper">
              <table class="excel-preview-table">
                <thead>
                  <tr>
                    <th>Columna A</th>
                    <th>Columna B</th>
                    <th>Columna C</th>
                    <th>Columna D</th>
                    <th>Columnas E en adelante</th>
                    <th>Última Columna (Opcional)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="header-preview-row">
                    <td><span class="col-pill">Marca temporal</span></td>
                    <td><span class="col-pill">Dirección de correo</span></td>
                    <td><span class="col-pill">Puntuación</span></td>
                    <td><span class="col-pill">Apellido y Nombre</span></td>
                    <td><span class="col-pill">Texto de cada pregunta</span></td>
                    <td><span class="col-pill">Consultas / Dudas</span></td>
                  </tr>
                  <tr class="desc-preview-row">
                    <td>Fecha y hora automática de envío</td>
                    <td>Correo del estudiante</td>
                    <td>Puntos obtenidos (ej: <code>12 / 15</code> o número)</td>
                    <td>Nombre completo del alumno</td>
                    <td>Una columna por cada consigna evaluada</td>
                    <td>Observaciones o dudas libres</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="callout callout-warning">
              ⚠️ <strong>Importante:</strong> No edites ni cambies el nombre de los encabezados de la fila 1 en el Excel. El motor del analizador utiliza esos textos para mapear automáticamente los puntajes y nombres.
            </div>
          </div>
        </div>

        <!-- PASO 4: SUBIR AL ANALIZADOR -->
        <div class="guide-step-block">
          <div class="step-num-badge">4</div>
          <div class="step-body">
            <div class="step-header-text">
              <h3>Subir el Archivo al Analizador</h3>
              <span class="step-sub">Procesamiento automático e instantáneo</span>
            </div>
            
            <ol class="step-ordered-list">
              <li>Ingresá a la herramienta en <a href="/analizador" class="inline-accent-link"><strong>psp.joif.net/analizador</strong></a>.</li>
              <li>Arrastrá y soltá el archivo <code>.xlsx</code> en el área punteada, o hacé clic en el botón <em>"Seleccionar archivo .xlsx"</em>.</li>
              <li>En menos de un segundo el sistema leerá los registros y cargará todo el panel interactivo.</li>
            </ol>

            <div class="callout callout-success">
              🔒 <strong>Privacidad y Confidencialidad Absoluta:</strong> Todo el procesamiento se realiza en el navegador web local de tu dispositivo. Ningún dato de los alumnos, nombres, correos ni calificaciones se envía ni se almacena en servidores externos.
            </div>
          </div>
        </div>

        <!-- PASO 5: ANÁLISIS PEDAGÓGICO -->
        <div class="guide-step-block">
          <div class="step-num-badge">5</div>
          <div class="step-body">
            <div class="step-header-text">
              <h3>Lectura y Análisis Pedagógico de los Resultados</h3>
              <span class="step-sub">Aprovechamiento de las métricas en la cátedra</span>
            </div>
            <p>La plataforma genera un reporte completo con métricas visuales para la toma de decisiones didácticas:</p>

            <div class="metrics-grid">
              <div class="metric-feature-card">
                <span class="metric-icon">📈</span>
                <h4>KPIs Globales</h4>
                <p>Promedio general del grupo, cantidad total de entregas y tasa porcentual de aprobación.</p>
              </div>

              <div class="metric-feature-card">
                <span class="metric-icon">🎯</span>
                <h4>Aciertos por Pregunta</h4>
                <p>Gráficos que señalan qué temas teóricos tuvieron menor rendimiento para reforzarlos en clase.</p>
              </div>

              <div class="metric-feature-card">
                <span class="metric-icon">🔍</span>
                <h4>Detalle de Errores</h4>
                <p>Al hacer clic en cada consigna, podés ver qué opciones incorrectas eligieron para detectar confusiones.</p>
              </div>

              <div class="metric-feature-card">
                <span class="metric-icon">👥</span>
                <h4>Tabla de Estudiantes</h4>
                <p>Clasificación rápida por nivel de rendimiento (Alto, Medio y Bajo) para tutorías personalizadas.</p>
              </div>
            </div>

            <!-- SECCIÓN DE VIDEO TUTORIAL DE YOUTUBE -->
            <div class="youtube-tutorial-section">
              <div class="youtube-section-header">
                <div class="youtube-badge-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="#ef4444">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                </div>
                <div>
                  <span class="tag-title">DEMOSTRACIÓN EN VIDEO</span>
                  <h4 class="youtube-title">{data.youtubeTitulo}</h4>
                  <p class="youtube-desc">{data.youtubeDescripcion}</p>
                </div>
              </div>

              {youtubeId ? (
                <div class="video-responsive-wrapper">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0`}
                    title={data.youtubeTitulo}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
              ) : (
                <div class="video-placeholder-box">
                  <div class="placeholder-play-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/>
                      <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/>
                    </svg>
                  </div>
                  <div class="placeholder-text">
                    <strong>Espacio para Video Tutorial de YouTube</strong>
                    <p>Podés vincular tu video explicativo cargando el enlace en el panel Keystatic CMS.</p>
                  </div>
                  <div class="placeholder-actions">
                    <a href="/keystatic/singleton/docentes" class="placeholder-cms-btn">
                      <span>✏️ Cargar enlace de YouTube en CMS</span>
                    </a>
                    {data.youtubeUrl && (
                      <a href={data.youtubeUrl} target="_blank" rel="noopener noreferrer" class="placeholder-link-btn">
                        <span>Ver en YouTube ↗</span>
                      </a>
                    )}
                  </div>
                </div>
              )}
            </div>

            <div class="guide-cta-row">
              <a href="/analizador" class="guide-btn primary-btn">
                <span>📊 Abrir Analizador de Autoevaluaciones Ahora ↗</span>
              </a>
              <a href="/correlatividades" class="guide-btn outline-btn">
                <span>🔗 Ver Plan de Estudios y Correlatividades</span>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Keystatic CMS direct access -->
    <section class="docentes-section">
      <div class="cms-invite-card">
        <div class="cms-icon">✏️</div>
        <div class="cms-info">
          <h3>Gestión completa de esta página en Keystatic CMS</h3>
          <p>
            Tanto los textos, el WhatsApp, el correo de contacto y el video de YouTube de esta página se configuran directamente desde el panel en <a href="/keystatic/singleton/docentes" class="inline-accent-link">psp.joif.net/keystatic</a>.
          </p>
        </div>
        <a href="/keystatic/singleton/docentes" class="cms-action-btn">
          <span>Abrir Configuración en CMS ↗</span>
        </a>
      </div>
    </section>
  </div>
</ObsidianLayout>

<script>
  // Copy template script
  const copyBtn = document.getElementById('copy-template-btn');
  const btnText = document.getElementById('copy-btn-text');
  const templateTextEl = document.getElementById('template-text');

  if (copyBtn && templateTextEl && btnText) {
    copyBtn.addEventListener('click', async () => {
      const text = templateTextEl.innerText;
      try {
        await navigator.clipboard.writeText(text);
        btnText.textContent = '¡Copiado al portapapeles!';
        copyBtn.classList.add('copied');
        setTimeout(() => {
          btnText.textContent = 'Copiar Plantilla';
          copyBtn.classList.remove('copied');
        }, 2500);
      } catch (e) {
        btnText.textContent = 'Error al copiar';
      }
    });
  }
</script>

<style>
  .docentes-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2.5rem 2rem 4rem;
    width: 100%;
    box-sizing: border-box;
  }

  .docentes-header {
    margin-bottom: 3rem;
  }

  .docentes-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-purple-hover);
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.25);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .docentes-title {
    font-size: 2.3rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .docentes-lead {
    font-size: 1.05rem;
    line-height: 1.65;
