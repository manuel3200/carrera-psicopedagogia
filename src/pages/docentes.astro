---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
---

<ObsidianLayout
  title="Espacio Docente, Soporte y Contacto"
  description="Guía de uso del analizador de autoevaluaciones, recepción de programas de examen y canales directos de contacto con Manuel Ortiz."
  breadcrumbs={[{ label: 'Espacio Docente' }]}
>
  <div class="docentes-page">
    <!-- Header -->
    <header class="docentes-header">
      <div class="docentes-badge">
        <span>👨‍🏫 ESPACIO PARA EQUIPOS DE CÁTEDRA</span>
        <span>•</span>
        <span>SOPORTE Y HERRAMIENTAS</span>
      </div>
      <h1 class="docentes-title">Espacio Docente y Centro de Contacto</h1>
      <p class="docentes-lead">
        Este portal es un proyecto autogestionado por <strong>Manuel Ortiz</strong>, estudiante de la carrera de Psicopedagogía. Su finalidad es colaborar activamente con los profesores, adscriptos y auxiliares, centralizando el material bibliográfico, facilitando herramientas digitales y brindando un canal ágil para mantener las 32 cátedras actualizadas.
      </p>
    </header>

    <!-- Communication Cards (WhatsApp & Correo) -->
    <section class="docentes-section">
      <div class="section-tag-box">
        <span class="tag-title">COMUNICACIÓN DIRECTA</span>
        <h2>Canales de Contacto con Manuel Ortiz</h2>
        <p class="section-desc">Elegí el medio que te resulte más cómodo para enviar programas, enlaces de Google Drive, correcciones o consultas sobre el portal.</p>
      </div>

      <div class="contact-grid">
        <!-- WhatsApp Card -->
        <div class="contact-card whatsapp-card">
          <div class="contact-icon-box whatsapp-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.101.005.234-.038.364.275.144.346.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.963 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.436 5.176L2 22l4.981-1.396A9.958 9.958 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.05c-1.634 0-3.148-.521-4.385-1.408l-.314-.225-2.955.828.84-2.859-.247-.336A8.04 8.04 0 0 1 3.95 12c0-4.439 3.611-8.05 8.05-8.05 4.439 0 8.05 3.611 8.05 8.05 0 4.439-3.611 8.05-8.05 8.05z"/>
            </svg>
          </div>
          <div class="contact-details">
            <span class="contact-type">WHATSAPP DIRECTO</span>
            <h3 class="contact-name">+54 370 502-1874</h3>
            <p class="contact-desc">Ideal para enviar enlaces rápidos, fotos de programas, audios o coordinar la carga de material.</p>
          </div>
          <a
            href="https://wa.me/543705021874?text=Hola%20Manuel%2C%20te%20escribo%20desde%20el%20portal%20psp.joif.net%20para%20acercarte%20datos%20de%20la%20c%C3%A1tedra%3A"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-action-btn whatsapp-btn"
          >
            <span>💬 Abrir WhatsApp</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>

        <!-- Email Card -->
        <div class="contact-card email-card">
          <div class="contact-icon-box email-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div class="contact-details">
            <span class="contact-type">CORREO ELECTRÓNICO</span>
            <h3 class="contact-name">manuelortiz1188@gmail.com</h3>
            <p class="contact-desc">Para adjuntar programas analíticos extensos en PDF, resoluciones o planificaciones anuales.</p>
          </div>
          <a
            href="mailto:manuelortiz1188@gmail.com?subject=Portal%20Psicopedagogia%20-%20Datos%20de%20Catedra&body=Hola%20Manuel%2C%0A%0AC%C3%A1tedra%3A%20%0AApartado%20a%20editar%3A%20%0ADatos%20a%20modificar%3A%20%0A"
            class="contact-action-btn email-btn"
          >
            <span>✉️ Enviar Correo</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Mini Guía de Edición / Plantilla -->
    <section class="docentes-section">
      <div class="template-card">
        <div class="template-header">
          <div class="template-title-box">
            <span class="tag-title">MINI GUÍA DE SOLICITUD</span>
            <h2>¿Cómo enviarme los datos para actualizar la página de tu materia?</h2>
          </div>
          <button id="copy-template-btn" class="copy-template-btn" title="Copiar plantilla al portapapeles">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span id="copy-btn-text">Copiar Plantilla</span>
          </button>
        </div>
        <p class="template-sub">
          Para que la carga sea inmediata y exacta, podés copiar y pegar esta estructura en WhatsApp o Correo completando los datos:
        </p>
        <div class="template-code-box">
          <pre id="template-text"><code>📚 Cátedra / Materia: [Ej: 05. Psicología Evolutiva I]
📌 Apartado a editar: [Ej: Enlace de Google Drive / Docentes / Programa / Bibliografía]
✏️ Datos nuevos o a modificar:
- Enlace / Archivo: [Pegá aquí el link de Drive o adjuntá el documento]
- Docentes a cargo: [Nombre, Apellido y Cargo o contacto]
- Modificación requerida: [Explicá qué texto o unidad querés cambiar]
📝 Observaciones adicionales: [Cualquier aclaración que consideres relevante]</code></pre>
        </div>
      </div>
    </section>

    <!-- Guía del Analizador de Excel -->
    <section class="docentes-section">
      <div class="analyzer-guide-card">
        <div class="guide-header">
          <div class="guide-icon-badge">📊</div>
          <div>
            <span class="tag-title">HERRAMIENTA PEDAGÓGICA</span>
            <h2>¿Cómo utilizar el Analizador de Autoevaluaciones Excel?</h2>
            <p class="guide-sub">
              Diseñado para procesar al instante las respuestas recopiladas en Google Forms sin necesidad de fórmulas complejas ni software pago.
            </p>
          </div>
        </div>

        <div class="steps-grid">
          <div class="step-card">
            <span class="step-badge">Paso 1</span>
            <h3>Abrir Google Forms</h3>
            <p>Ingresá al formulario de autoevaluación o trabajo práctico de tu materia en Google Drive.</p>
          </div>

          <div class="step-card">
            <span class="step-badge">Paso 2</span>
            <h3>Ver Hojas de Cálculo</h3>
            <p>Hacé clic en la pestaña <strong>"Respuestas"</strong> y luego en el icono verde <strong>"Ver en Hojas de cálculo"</strong>.</p>
          </div>

          <div class="step-card">
            <span class="step-badge">Paso 3</span>
            <h3>Descargar como Excel</h3>
            <p>En el menú superior de Google Sheets, seleccioná <strong>Archivo ➔ Descargar ➔ Microsoft Excel (.xlsx)</strong>.</p>
          </div>

          <div class="step-card">
            <span class="step-badge">Paso 4</span>
            <h3>Arrastrar al Analizador</h3>
            <p>Entrá a <a href="/analizador" class="inline-accent-link">psp.joif.net/analizador</a> y arrastrá el archivo descargado.</p>
          </div>
        </div>

        <div class="privacy-callout">
          <div class="privacy-icon">🔒</div>
          <div class="privacy-text">
            <strong>Privacidad y Seguridad Garantizada:</strong> El procesamiento de los datos se realiza íntegramente en el navegador web de tu dispositivo. Ningún nombre, correo ni calificación se almacena ni se transmite a servidores externos.
          </div>
        </div>

        <div class="guide-footer-action">
          <a href="/analizador" class="guide-btn primary-btn">
            <span>📊 Abrir Analizador de Autoevaluaciones ↗</span>
          </a>
          <a href="/correlatividades" class="guide-btn outline-btn">
            <span>🔗 Consultar Mapa de Correlatividades (Res. 18/13)</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Keystatic CMS direct access -->
    <section class="docentes-section">
      <div class="cms-invite-card">
        <div class="cms-icon">✏️</div>
        <div class="cms-info">
          <h3>¿Preferís editar vos mismo/a la ficha de tu cátedra?</h3>
          <p>
            Contamos con un panel de administración en <a href="/keystatic" class="inline-accent-link">psp.joif.net/keystatic</a> con sincronización directa a GitHub. Si formás parte del equipo de cátedra y querés contar con un usuario editor, escribime a cualquiera de los canales y te habilito el acceso.
          </p>
        </div>
        <a href="/keystatic" class="cms-action-btn">
          <span>Abrir Panel CMS ↗</span>
        </a>
      </div>
    </section>
  </div>
</ObsidianLayout>

<script>
  // Copy template script
  const copyBtn = document.getElementById('copy-template-btn');
  const btnText = document.getElementById('copy-btn-text');
  const templateTextEl = document.getElementById('template-text');

  if (copyBtn && templateTextEl && btnText) {
    copyBtn.addEventListener('click', async () => {
      const text = templateTextEl.innerText;
      try {
        await navigator.clipboard.writeText(text);
        btnText.textContent = '¡Copiado al portapapeles!';
        copyBtn.classList.add('copied');
        setTimeout(() => {
          btnText.textContent = 'Copiar Plantilla';
          copyBtn.classList.remove('copied');
        }, 2500);
      } catch (e) {
        btnText.textContent = 'Error al copiar';
      }
    });
  }
</script>

<style>
  .docentes-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2.5rem 2rem 4rem;
  }

  .docentes-header {
    margin-bottom: 3rem;
  }

  .docentes-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-purple-light);
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.25);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .docentes-title {
    font-size: 2.3rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .docentes-lead {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .docentes-lead strong {
    color: var(--text-main);
  }

  .docentes-section {
    margin-bottom: 3rem;
  }

  .section-tag-box {
    margin-bottom: 1.25rem;
  }

  .tag-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-purple-light);
    display: block;
    margin-bottom: 4px;
  }

  .section-tag-box h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .section-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Contact Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .contact-card {
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.2s;
  }

  .contact-card:hover {
    border-color: var(--color-purple-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .whatsapp-card {
    border-top: 3px solid #25d366;
  }

  .email-card {
    border-top: 3px solid var(--color-purple);
  }

  .contact-icon-box {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .whatsapp-icon {
    background: rgba(37, 211, 102, 0.12);
    color: #25d366;
  }

  .email-icon {
    background: rgba(139, 92, 246, 0.15);
    color: var(--color-purple-light);
  }

  .contact-type {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    display: block;
    margin-bottom: 4px;
  }

  .contact-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .contact-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1.5rem;
