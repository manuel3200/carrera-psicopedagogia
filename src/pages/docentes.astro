    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .guide-icon-badge {
    font-size: 2rem;
    width: 54px;
    height: 54px;
    background: rgba(139, 92, 246, 0.12);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .guide-header h2 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .guide-sub {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .step-card {
    background: var(--bg-vault);
