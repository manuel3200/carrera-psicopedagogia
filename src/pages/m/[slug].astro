---
import ObsidianLayout from '../../layouts/ObsidianLayout.astro';
import { getAllMaterias, getSlugForCorrelativa } from '../../utils/materias';

export async function getStaticPaths() {
  const materias = getAllMaterias();
  return materias.map(m => ({
    params: { slug: m.slug },
    props: { materia: m, allMaterias: materias },
  }));
}

const { materia, allMaterias } = Astro.props;

// Compute correlativas with interactive links
const correlativasCursar = materia.paraCursar.map(req => ({
  raw: req,
  info: getSlugForCorrelativa(req, allMaterias),
}));

const correlativasRendir = materia.paraRendir.map(req => ({
  raw: req,
  info: getSlugForCorrelativa(req, allMaterias),
}));

const anoLabel = `${materia.ano}º Año`;
const cuatriLabel = materia.cuatrimestre === 'anual' ? 'Anual' : `${materia.cuatrimestre}º Cuatrimestre`;
---

<ObsidianLayout
  title={`${materia.numero}. ${materia.nombre}`}
  description={materia.descripcion}
  currentSlug={materia.slug}
  breadcrumbs={[
    { label: anoLabel },
    { label: cuatriLabel },
    { label: materia.nombre },
  ]}
>
  <article class="materia-page">
    <!-- Header Banner -->
    <header class="materia-header">
      <div class="materia-meta-row">
        <span class="materia-num-badge">Cátedra #{materia.numero}</span>
        <span class="materia-plan-badge">{anoLabel} • {cuatriLabel}</span>
        <span class="materia-plan-badge">Resolución 18/13</span>
      </div>

      <h1 class="materia-title">
        <span class="materia-icon">{materia.icono || '📚'}</span>
        {materia.nombre}
      </h1>

      {materia.descripcion && (
        <p class="materia-lead">{materia.descripcion}</p>
      )}
    </header>

    <!-- Main Action Buttons (Drive & Analizador) -->
    <section class="materia-action-cards">
      {materia.driveUrl && (
        <a href={materia.driveUrl} target="_blank" rel="noopener noreferrer" class="action-card drive-card">
          <div class="card-icon-box">📁</div>
          <div class="card-content">
            <span class="card-tag">Repositorio en la Nube</span>
            <h3 class="card-title">Carpeta Oficial en Google Drive ↗</h3>
            <p class="card-text">Accedé a toda la bibliografía obligatoria, programas de examen y guías de lectura en la nube.</p>
          </div>
        </a>
      )}

      <a href="/analizador" class="action-card analyzer-card">
        <div class="card-icon-box">📊</div>
        <div class="card-content">
          <span class="card-tag">Herramienta Docente & Pedagógica</span>
          <h3 class="card-title">Analizador de Autoevaluaciones Excel ↗</h3>
          <p class="card-text">Procesá las respuestas de formularios (.xlsx) y obtené métricas de aprobación al instante.</p>
        </div>
      </a>
    </section>

    <!-- Correlatividades Section (Resolución 18/13) -->
    <section class="materia-correlatividades-box">
      <div class="box-header">
        <div class="box-header-title">
          <span>🔗</span>
          <h2>Régimen Oficial de Correlatividades (Res. 18/13)</h2>
        </div>
        <a href="/correlatividades" class="view-all-link">Ver plan completo ↗</a>
      </div>

      <div class="correlat-grid">
        <!-- Requisitos para Cursar -->
        <div class="correlat-col">
          <div class="col-badge req-cursar">
            <span>📘</span> Para Cursar esta materia necesitás:
          </div>

          {correlativasCursar.length === 0 ? (
            <div class="correlat-empty">
              <span>✨</span>
              <p>Sin correlatividades previas. ¡Materia de cursado libre!</p>
            </div>
          ) : (
            <ul class="correlat-list">
              {correlativasCursar.map(req => (
                <li class="correlat-item">
                  <span class={`badge-status ${req.info.status === 'A' ? 'badge-aprobada' : 'badge-regularizada'}`}>
                    {req.info.status === 'A' ? 'Aprobada (A)' : 'Regularizada (R)'}
                  </span>
                  {req.info.slug ? (
                    <a href={`/m/${req.info.slug}`} class="correlat-link" title="Ir a la ficha de esta materia">
                      {req.info.name} ↗
                    </a>
                  ) : (
                    <span class="correlat-plain">{req.raw}</span>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>

        <!-- Requisitos para Rendir Examen Final -->
        <div class="correlat-col">
          <div class="col-badge req-rendir">
            <span>📗</span> Para Rendir Examen Final necesitás:
          </div>

          {correlativasRendir.length === 0 ? (
            <div class="correlat-empty">
              <span>✨</span>
              <p>Sin requisitos adicionales para rendir examen final.</p>
            </div>
          ) : (
            <ul class="correlat-list">
              {correlativasRendir.map(req => (
                <li class="correlat-item">
                  <span class="badge-status badge-aprobada">Aprobada (A)</span>
                  {req.info.slug ? (
                    <a href={`/m/${req.info.slug}`} class="correlat-link" title="Ir a la ficha de esta materia">
                      {req.info.name} ↗
                    </a>
                  ) : (
                    <span class="correlat-plain">{req.raw}</span>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>

    <!-- Unidades Temáticas / Programa -->
    {materia.unidades && materia.unidades.length > 0 && (
      <section class="materia-section">
        <div class="section-title-box">
          <span>📖</span>
          <h2>Ejes Temáticos y Programa</h2>
        </div>

        <div class="unidades-list">
          {materia.unidades.map(u => (
            <div class="unidad-card">
              <div class="unidad-header">
                <span class="unidad-num">Unidad {u.numero}</span>
                <h3 class="unidad-title">{u.titulo}</h3>
              </div>
              {u.descripcion && <p class="unidad-desc">{u.descripcion}</p>}
              {u.bibliografia && (
                <div class="unidad-biblio">
                  <strong>Bibliografía sugerida:</strong> {u.bibliografia}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Enlaces y Recursos adicionales -->
    {materia.enlacesAdicionales && materia.enlacesAdicionales.length > 0 && (
      <section class="materia-section">
        <div class="section-title-box">
          <span>🌐</span>
          <h2>Recursos y Enlaces Útiles</h2>
        </div>
        <div class="links-grid">
          {materia.enlacesAdicionales.map(link => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-card">
              <h4>{link.titulo} ↗</h4>
              {link.descripcion && <p>{link.descripcion}</p>}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Footer Edit Link -->
    <footer class="materia-footer">
      <div class="footer-edit-box">
        <span>¿Sos docente de esta materia o querés acercar programas, bibliografía o correcciones?</span>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <a href="/docentes" class="btn-edit-keystatic" style="background:rgba(139,92,246,0.15); color:#c4b5fd; border:1px solid rgba(139,92,246,0.3);">
            👨‍🏫 Espacio Docente & Contacto
          </a>
          <a href="/keystatic" class="btn-edit-keystatic">
            Editar en Keystatic CMS ✏️
          </a>
        </div>
      </div>
    </footer>
  </article>
</ObsidianLayout>

<style>
  .materia-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .materia-header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-vault);
  }

  .materia-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .materia-num-badge {
    background: var(--accent-purple-dim);
    color: #ede9fe;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .materia-plan-badge {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .materia-title {
    font-size: 2.1rem;
    font-weight: 800;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 12px;
    line-height: 1.2;
  }

  .materia-icon {
    font-size: 2rem;
  }

  .materia-lead {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-top: 0.85rem;
    line-height: 1.6;
    max-width: 800px;
  }

  .materia-action-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .action-card {
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    transition: all 0.2s ease;
  }

  .action-card:hover {
    border-color: var(--accent-purple);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
  }

  .card-icon-box {
    font-size: 2.2rem;
    flex-shrink: 0;
  }

  .card-tag {
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: var(--accent-purple);
    text-transform: uppercase;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 4px 0 6px 0;
  }

  .card-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Correlatividades Box */
  .materia-correlatividades-box {
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-vault);
  }

  .box-header-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .box-header-title h2 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .view-all-link {
    font-size: 0.82rem;
    color: var(--accent-purple-hover);
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .correlat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .col-badge {
    font-size: 0.82rem;
    font-weight: 700;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .col-badge.req-cursar {
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .col-badge.req-rendir {
    background: rgba(16, 185, 129, 0.12);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .correlat-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .correlat-item {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-vault);
    border: 1px solid var(--border-vault);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
  }

  .badge-status {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .badge-regularizada {
    background: #78350f;
    color: #fef3c7;
  }

  .badge-aprobada {
    background: #064e3b;
    color: #d1fae5;
  }

  .correlat-link {
    color: var(--text-main);
    font-weight: 600;
  }

  .correlat-link:hover {
    color: var(--accent-purple-hover);
    text-decoration: underline;
  }

  .correlat-empty {
    padding: 1rem;
    background: var(--bg-vault);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Unidades Section */
  .materia-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-title-box {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-title-box h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .unidades-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .unidad-card {
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .unidad-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0.5rem;
  }

  .unidad-num {
    background: var(--bg-vault);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-purple);
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
  }

  .unidad-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .unidad-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .unidad-biblio {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-vault);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .materia-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-vault);
  }

  .footer-edit-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .btn-edit-keystatic {
    background: var(--accent-purple);
    color: white;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    transition: background 0.15s;
  }

  .btn-edit-keystatic:hover {
    background: var(--accent-purple-dim);
  }
</style>
