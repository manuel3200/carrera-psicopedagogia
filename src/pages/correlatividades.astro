---
import ObsidianLayout from '../layouts/ObsidianLayout.astro';
import { getAllMaterias, getSlugForCorrelativa } from '../utils/materias';

const materias = getAllMaterias();

const materiasWithLinks = materias.map(m => ({
  ...m,
  paraCursarResolved: m.paraCursar.map(r => ({
    raw: r,
    info: getSlugForCorrelativa(r, materias)
  })),
  paraRendirResolved: m.paraRendir.map(r => ({
    raw: r,
    info: getSlugForCorrelativa(r, materias)
  }))
}));
---

<ObsidianLayout
  title="Régimen de Correlatividades (Res. 18/13)"
  description="Plan de estudios oficial y régimen de correlatividades de la Carrera de Psicopedagogía"
  breadcrumbs={[{ label: 'Régimen de Correlatividades' }]}
>
  <div class="correlat-page">
    <header class="page-header">
      <span class="header-badge">RESOLUCIÓN 18/13 • PROGRAMA DE TUTORÍA</span>
      <h1 class="header-title">Régimen Oficial de Correlatividades</h1>
      <p class="header-desc">
        Consulta el mapa completo de las 32 cátedras de la carrera. Haz clic en cualquier materia para ingresar a su ficha con el acceso al Google Drive oficial y herramientas de cátedra.
      </p>

      <div class="simulador-promo-banner">
        <div class="promo-icon">🎯</div>
        <div class="promo-text">
          <strong>¿Querés saber qué podés cursar o rendir según tu avance actual?</strong>
          <span>Probá el nuevo <strong>Simulador Interactivo</strong> que calcula tus correlatividades habilitadas en tiempo real.</span>
        </div>
        <a href="/simulador" class="promo-cta-btn">
          Abrir Simulador ➔
        </a>
      </div>
    </header>

    <!-- Filter Toolbar: Año + Buscador en Vivo -->
    <div class="filter-toolbar">
      <div class="filter-row">
        <button class="filter-btn active" data-year="all">Todas las Materias (32)</button>
        <button class="filter-btn" data-year="1">1º Año (7)</button>
        <button class="filter-btn" data-year="2">2º Año (7)</button>
        <button class="filter-btn" data-year="3">3º Año (9)</button>
        <button class="filter-btn" data-year="4">4º Año (9)</button>
      </div>

      <div class="table-search-box">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="table-search-input" placeholder="Filtrar materia o requisito..." aria-label="Filtrar materias en la tabla" />
      </div>
    </div>

    <!-- Table of Correlatividades -->
    <div class="table-card">
      <div class="table-responsive">
        <table class="correlat-table">
          <thead>
            <tr>
              <th style="width: 60px;">Nº</th>
              <th>Materia / Cátedra</th>
              <th style="width: 140px;">Ubicación</th>
              <th>Para Cursar Requiere</th>
              <th>Para Rendir Requiere</th>
              <th style="width: 90px;">Acción</th>
            </tr>
          </thead>
          <tbody>
            {materiasWithLinks.map(m => {
              const searchable = `${m.numero} ${m.nombre} ${m.ano} ${m.paraCursar.join(' ')} ${m.paraRendir.join(' ')}`;
              return (
                <tr class="table-row" data-year={m.ano} data-search={searchable}>
                  <td class="td-num">
                    <span class="num-tag">{m.numero}</span>
                  </td>
                  <td class="td-name">
                    <div class="name-box">
                      <span class="m-icon">{m.icono || '📚'}</span>
                      <div>
                        <a href={`/m/${m.slug}`} class="m-link">{m.nombre}</a>
                        {m.driveUrl && <span class="drive-indicator" title="Tiene Google Drive vinculado">📁</span>}
                      </div>
                    </div>
                  </td>
                  <td class="td-loc">
                    <span class="loc-tag">{m.ano}º Año • {m.cuatrimestre}º C</span>
                  </td>
                  <td class="td-cursar">
                    {m.paraCursarResolved.length === 0 ? (
                      <span class="libre-tag">— Libre —</span>
                    ) : (
                      <ul class="req-chips">
                        {m.paraCursarResolved.map(req => (
                          <li class="req-chip chip-r">
                            {req.info.slug ? (
                              <a href={`/m/${req.info.slug}`} class="req-chip-link" title={`Ver correlativa: ${req.info.name}`}>
                                <span class="req-chip-status">{req.info.status === 'A' ? '(A)' : '(R)'}</span>
                                <span class="req-chip-name">{req.info.name}</span>
                                <span class="req-chip-arrow">↗</span>
                              </a>
                            ) : (
                              <span class="req-chip-plain">{req.raw}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </td>
                  <td class="td-rendir">
                    {m.paraRendirResolved.length === 0 ? (
                      <span class="libre-tag">— Libre —</span>
                    ) : (
                      <ul class="req-chips">
                        {m.paraRendirResolved.map(req => (
                          <li class="req-chip chip-a">
                            {req.info.slug ? (
                              <a href={`/m/${req.info.slug}`} class="req-chip-link" title={`Ver correlativa: ${req.info.name}`}>
                                <span class="req-chip-status">(A)</span>
                                <span class="req-chip-name">{req.info.name}</span>
                                <span class="req-chip-arrow">↗</span>
                              </a>
                            ) : (
                              <span class="req-chip-plain">{req.raw}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </td>
                  <td class="td-action">
                    <a href={`/m/${m.slug}`} class="view-btn">Ver ↗</a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    function normalize(str: string) {
      return (str || '')
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();
    }

    const filterBtns = document.querySelectorAll('.filter-btn');
    const searchInput = document.getElementById('table-search-input') as HTMLInputElement;
    const rows = document.querySelectorAll('.table-row');

    let currentYear = 'all';
    let currentQuery = '';

    function applyFilters() {
      const q = normalize(currentQuery);
      rows.forEach(r => {
        const rowYear = r.getAttribute('data-year');
        const rowSearch = normalize(r.getAttribute('data-search') || '');

        const matchesYear = currentYear === 'all' || rowYear === currentYear;
        const matchesQuery = !q || rowSearch.includes(q);

        if (matchesYear && matchesQuery) {
          (r as HTMLElement).style.display = '';
        } else {
          (r as HTMLElement).style.display = 'none';
        }
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentYear = btn.getAttribute('data-year') || 'all';
        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value;
        applyFilters();
      });
    }
  </script>
</ObsidianLayout>

<style>
  .correlat-page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-header {
    border-bottom: 1px solid var(--border-vault);
    padding-bottom: 1.25rem;
  }

  .header-badge {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--accent-purple);
  }

  .header-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 4px 0 8px 0;
  }

  .header-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 760px;
  }

  .filter-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .filter-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .table-search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    color: var(--text-muted);
    min-width: 250px;
    transition: border-color 0.15s;
  }

  .table-search-box:focus-within {
    border-color: var(--accent-purple);
    color: var(--text-main);
  }

  .table-search-box input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-main);
    font-size: 0.82rem;
    width: 100%;
  }

  .table-search-box input::placeholder {
    color: var(--text-faint);
  }

  .filter-btn {
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    color: var(--text-muted);
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.12s;
  }

  .filter-btn:hover {
    color: var(--text-main);
    border-color: var(--accent-purple);
  }

  .filter-btn.active {
    background: var(--accent-purple);
    color: white;
    border-color: var(--accent-purple);
    font-weight: 600;
  }

  .table-card {
    background: var(--bg-card);
    border: 1px solid var(--border-vault);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .correlat-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.84rem;
  }

  .correlat-table th {
    background: var(--bg-sidebar-ribbon);
    color: var(--text-faint);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border-vault);
  }

  .correlat-table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--border-vault);
    vertical-align: middle;
  }

  .table-row:hover {
    background: var(--bg-card-hover);
  }

  .num-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--bg-vault);
    color: var(--accent-purple);
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
  }

  .name-box {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .m-link {
    color: var(--text-main);
    font-weight: 600;
  }

  .m-link:hover {
    color: var(--accent-purple-hover);
    text-decoration: underline;
  }

  .drive-indicator {
    font-size: 0.75rem;
    margin-left: 4px;
  }

  .loc-tag {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--bg-vault);
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .req-chips {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .req-chip {
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 4px;
    display: inline-block;
    transition: transform 0.1s ease, border-color 0.15s ease;
  }

  .req-chip:hover {
    transform: translateX(2px);
  }

  .req-chip-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: inherit;
    text-decoration: none;
  }

  .req-chip-link:hover .req-chip-name {
    text-decoration: underline;
  }

  .req-chip-status {
    font-weight: 700;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0.9;
  }

  .req-chip-arrow {
    font-size: 0.65rem;
    opacity: 0.6;
    margin-left: 2px;
  }

  .chip-r {
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .chip-a {
    background: rgba(16, 185, 129, 0.12);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .libre-tag {
    color: var(--text-faint);
    font-size: 0.75rem;
    font-style: italic;
  }

  .view-btn {
    font-size: 0.78rem;
    color: var(--accent-purple-hover);
    background: var(--bg-vault);
    border: 1px solid var(--border-vault);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    display: inline-block;
    transition: all 0.12s;
  }

  .view-btn:hover {
    background: var(--accent-purple);
    color: white;
    border-color: var(--accent-purple);
  }

  /* Banner Promocional del Simulador */
  .simulador-promo-banner {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: linear-gradient(90deg, rgba(124, 58, 237, 0.15) 0%, rgba(56, 189, 248, 0.1) 100%);
    border: 1px solid rgba(124, 58, 237, 0.35);
    border-radius: 10px;
    padding: 0.85rem 1.25rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  .promo-icon {
    font-size: 1.6rem;
    line-height: 1;
  }

  .promo-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.85rem;
    color: var(--text-normal);
  }

  .promo-text strong {
    color: #ffffff;
    font-size: 0.92rem;
  }

  .promo-text span {
    color: var(--text-muted);
  }

  .promo-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--accent);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s ease;
    box-shadow: 0 2px 8px rgba(124, 58, 237, 0.4);
  }

  .promo-cta-btn:hover {
    background: #6d28d9;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.6);
  }

  @media (max-width: 640px) {
    .simulador-promo-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .promo-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
