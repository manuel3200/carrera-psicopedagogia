---
import ObsidianSidebar from '../components/ObsidianSidebar.astro';
import QuickSearch from '../components/QuickSearch.astro';
import '../styles/obsidian.css';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
  breadcrumbs?: Array<{ label: string; url?: string }>;
}

const {
  title,
  description = "Portal Central y Vault Académico de la Carrera de Psicopedagogía",
  currentSlug = '',
  breadcrumbs = []
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Vault Psicopedagogía</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
</head>
<body>
  <!-- Top Navigation Header -->
  <header class="vault-topbar">
    <div class="topbar-left">
      <button class="topbar-btn" id="sidebar-toggle-btn" title="Abrir o cerrar explorador (Ctrl+B)" aria-label="Abrir o cerrar explorador">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

      <!-- Brand Title -->
      <a href="/" class="topbar-brand" title="Inicio - Vault Psicopedagogía">
        <span class="topbar-brand-icon">🏛️</span>
        <span class="topbar-brand-text">Psicopedagogía</span>
      </a>

      <!-- Breadcrumbs -->
      {breadcrumbs.length > 0 && (
        <nav class="topbar-breadcrumbs" aria-label="Ruta de navegación">
          {breadcrumbs.map(b => (
            <>
              <span class="breadcrumb-sep">/</span>
              {b.url ? (
                <a href={b.url} class="breadcrumb-link">{b.label}</a>
              ) : (
                <span class="breadcrumb-current">{b.label}</span>
              )}
            </>
          ))}
        </nav>
      )}
    </div>

    <!-- Center Search Trigger -->
    <div class="topbar-center">
      <button class="topbar-search-trigger" id="topbar-search-btn" type="button" aria-label="Buscar en el Vault">
        <div class="search-placeholder">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <span class="search-text-full">Buscar materia, apunte o correlativa...</span>
          <span class="search-text-mobile">Buscar...</span>
        </div>
        <kbd class="search-kbd">Ctrl K</kbd>
      </button>
    </div>

    <!-- Right Actions -->
    <div class="topbar-right">
      <a href="/docentes" class="topbar-link" title="Espacio Docente y Contacto">
        <span class="link-icon">👨‍🏫</span>
        <span class="link-label">Docentes</span>
      </a>
      <a href="/analizador" class="topbar-link" title="Analizador Excel de Autoevaluaciones">
        <span class="link-icon">📊</span>
        <span class="link-label">Analizador</span>
      </a>
      <a href="/correlatividades" class="topbar-link" title="Mapa del Plan de Estudios">
        <span class="link-icon">🔗</span>
        <span class="link-label">Plan 18/13</span>
      </a>
      <a href="/keystatic" class="topbar-link admin-btn" title="Panel CMS Keystatic">
        <span class="link-icon">✏️</span>
        <span class="link-label">CMS</span>
      </a>
    </div>
  </header>

  <!-- Mobile Backdrop Overlay -->
  <div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>

  <!-- Main Grid Layout -->
  <div class="vault-layout">
    <ObsidianSidebar currentSlug={currentSlug} />

    <main class="vault-main">
      <slot />
    </main>
  </div>

  <!-- Quick Search Modal -->
  <QuickSearch />

  <script>
    // Unified Sidebar Controller for Desktop & Mobile
    const sidebar = document.getElementById('obsidian-sidebar');
    const collapseBtn = document.getElementById('sidebar-collapse-btn');
    const toggleBtn = document.getElementById('sidebar-toggle-btn');
    const folderBtn = document.getElementById('ribbon-folder-btn');
    const mobileClose = document.getElementById('mobile-sidebar-close');
    const backdrop = document.getElementById('sidebar-backdrop');
    const topbarSearch = document.getElementById('topbar-search-btn');

    function toggleSidebar() {
      if (!sidebar) return;
      if (window.innerWidth <= 768) {
        const isOpen = sidebar.classList.toggle('mobile-open');
        if (backdrop) backdrop.classList.toggle('active', isOpen);
      } else {
        const isCollapsed = sidebar.classList.toggle('collapsed');
        if (folderBtn) folderBtn.classList.toggle('active', !isCollapsed);
        localStorage.setItem('obsidian-sidebar-collapsed', isCollapsed ? 'true' : 'false');
      }
    }

    function closeMobileSidebar() {
      if (!sidebar) return;
      sidebar.classList.remove('mobile-open');
      if (backdrop) backdrop.classList.remove('active');
    }

    // Restore desktop collapsed state from localStorage
    if (sidebar && window.innerWidth > 768) {
      if (localStorage.getItem('obsidian-sidebar-collapsed') === 'true') {
        sidebar.classList.add('collapsed');
        if (folderBtn) folderBtn.classList.remove('active');
      }
    }

    // Event listeners
    if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
    if (collapseBtn) collapseBtn.addEventListener('click', toggleSidebar);
    if (folderBtn) folderBtn.addEventListener('click', toggleSidebar);
    if (mobileClose) mobileClose.addEventListener('click', closeMobileSidebar);
    if (backdrop) backdrop.addEventListener('click', closeMobileSidebar);

    // Close drawer when clicking a materia link on mobile
    document.querySelectorAll('.tree-file-link, .tree-extra-link').forEach(el => {
      el.addEventListener('click', () => {
        if (window.innerWidth <= 768) closeMobileSidebar();
      });
    });

    // Keyboard shortcut Ctrl+B / Cmd+B for sidebar toggle
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
        e.preventDefault();
        toggleSidebar();
      }
    });

    // Trigger Search Modal
    function handleOpenSearch() {
      if (typeof (window as any).openQuickSearch === 'function') {
        (window as any).openQuickSearch();
      }
    }

    if (topbarSearch) {
      topbarSearch.addEventListener('click', handleOpenSearch);
    }
  </script>
</body>
</html>
